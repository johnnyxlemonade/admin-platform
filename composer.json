{
  "name": "johnnyxlemonade/admin-platform",
  "description": "Reusable Lemonade administration and module platform.",
  "type": "library",
  "license": "Apache-2.0",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/johnnyxlemonade/framework"
    },
    {
      "type": "vcs",
      "url": "https://github.com/johnnyxlemonade/admin-image"
    },
    {
      "type": "vcs",
      "url": "https://github.com/johnnyxlemonade/cms-core"
    }
  ],
  "require": {
    "php": ">=8.3 <8.6",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "guzzlehttp/guzzle": "^7.10",
    "johnnyxlemonade/framework": "dev-master",
    "johnnyxlemonade/cms-core": "dev-main",
    "johnnyxlemonade/admin-image": "dev-main",
    "league/oauth2-client": "^2.9",
    "nyholm/psr7": "^1.8",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "web-token/jwt-framework": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "Lemonade\\Admin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lemonade\\Admin\\Tests\\": "tests/"
    }
  },
  "extra": {
    "lemonade": {
      "modules": [
        "Lemonade\\Admin\\System\\Audit\\ModuleManifest",
        "Lemonade\\Admin\\System\\Languages\\ModuleManifest",
        "Lemonade\\Admin\\System\\Media\\ModuleManifest",
        "Lemonade\\Admin\\System\\Modules\\ModuleManifest",
        "Lemonade\\Admin\\System\\Notifications\\ModuleManifest",
        "Lemonade\\Admin\\System\\Roles\\ModuleManifest",
        "Lemonade\\Admin\\System\\Translations\\ModuleManifest",
        "Lemonade\\Admin\\System\\Users\\ModuleManifest"
      ]
    }
  },
  "scripts": {
    "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix --allow-risky=yes",
    "stan": "@php vendor/bin/phpstan analyse --memory-limit=4G",
    "test": "@php vendor/bin/phpunit",
    "qa": ["@cs:check", "@stan", "@test"]
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan": "2.3.0",
    "phpstan/phpstan-strict-rules": "2.1.0",
    "phpunit/phpunit": "^10.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
